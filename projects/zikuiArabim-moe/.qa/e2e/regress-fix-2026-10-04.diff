+// Generated by qa-tester © 2026 Nikita Morozov (ניקיטה מורוזוב / Никита Морозов). All rights reserved. ID: QAT-NM-2026-344086DC45B0
+// «התחל תפילה» на /home — независимо от часа.
+// Согласованное решение (2026-10-04, .qa/context.md): вне окна молитвы кнопка неактивна, рядом «<תפילה> מתחילה ב-HH:MM» — норма.
+// Если кнопка активна — нажимаем её (как раньше). Если неактивна — проверяем disabled + «מתחילה ב-…» в карточке
+// и открываем страницу той же молитвы напрямую: /prayer/<תפילה>_<נוסח> — молитва и нусах берутся из карточки
+// (нусах в карточке идёт из профиля), так что проверки страницы молитвы остаются теми же.
+import { expect, Page } from '@playwright/test';
+
+const PRAYER_IDS: Record<string, string> = { 'שחרית': 'shacharit', 'מנחה': 'mincha', 'ערבית': 'arvit' };
+const NUSACH_IDS: Record<string, string> = { 'אשכנז': 'ashkenaz', 'ספרד': 'sfarad' };
+
+export type StartMode = 'button' | 'direct';
+
+/** Вызывать на открытой /home. Возвращает, как открыта молитва: кнопкой или напрямую. */
+export async function startNearestPrayer(page: Page): Promise<StartMode> {
+  const start = page.getByRole('button', { name: 'התחל תפילה' });
+  const enabled = page.getByRole('button', { name: 'התחל תפילה', disabled: false });
+  const card = start.locator('xpath=..');
+  const startsAt = card.getByText(/מתחילה ב-?\s?\d{1,2}:\d{2}/);
+
+  // Дождаться загрузки карточки: либо активная кнопка, либо строка «… מתחילה ב-HH:MM».
+  await expect(enabled.or(startsAt).first()).toBeVisible({ timeout: 20_000 });
+
+  if (await enabled.isVisible()) {
+    await enabled.click();
+    return 'button';
+  }
+
+  // Вне окна молитвы: кнопка неактивна, рядом время начала.
+  await expect(start).toBeDisabled();
+  await expect(startsAt).toBeVisible();
+  const cardText = await card.innerText();
+  const prayer = Object.keys(PRAYER_IDS).find((p) => cardText.includes(p));
+  const nusach = cardText.match(/נוסח (אשכנז|ספרד)/)?.[1];
+  expect(prayer, `В карточке ближайшей молитвы не найдено название: «${cardText}»`).toBeTruthy();
+  expect(nusach, `В карточке ближайшей молитвы не найден נוסח: «${cardText}»`).toBeTruthy();
+  await page.goto(`/prayer/${PRAYER_IDS[prayer!]}_${NUSACH_IDS[nusach!]}`);
+  return 'direct';
+}
