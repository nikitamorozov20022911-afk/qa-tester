+// Generated by qa-tester © 2026 Nikita Morozov (ניקיטה מורוזוב / Никита Морозов). All rights reserved. ID: QAT-NM-2026-344086DC45B0
+// Даты для тестов: «сегодня» берётся реальное, ожидаемые строки вычисляются в формате приложения.
+// Еврейская дата — Intl.DateTimeFormat('he-u-ca-hebrew') + перевод чисел в буквы с гершаим
+// (как в приложении: «כ״ב תשרי תשפ״ז», «כ׳ תשרי», «חשון» без второй ו).
+// Часовой пояс — локальный (браузер Playwright запускается на той же машине, timezoneId в конфиге не задан).
+
+const ONES = ['', 'א', 'ב', 'ג', 'ד', 'ה', 'ו', 'ז', 'ח', 'ט'];
+const TENS = ['', 'י', 'כ', 'ל', 'מ', 'נ', 'ס', 'ע', 'פ', 'צ'];
+const HUNDREDS = ['', 'ק', 'ר', 'ש', 'ת', 'תק', 'תר', 'תש', 'תת', 'תתק'];
+
+// Название месяца так, как его пишет приложение (Hebcal-стиль).
+const MONTH_FIX: Record<string, string> = { 'חשוון': 'חשון', 'סיוון': 'סיון' };
+
+/** Число → буквы с гершаим: 22 → «כ״ב», 20 → «כ׳», 15 → «ט״ו», 787 → «תשפ״ז». */
+export function gematria(n: number): string {
+  let s = HUNDREDS[Math.floor(n / 100)];
+  const rest = n % 100;
+  if (rest === 15) s += 'טו';
+  else if (rest === 16) s += 'טז';
+  else s += TENS[Math.floor(rest / 10)] + ONES[rest % 10];
+  if (s.length === 1) return `${s}׳`;
+  return `${s.slice(0, -1)}״${s.slice(-1)}`;
+}
+
+/** Полдень того же локального дня (чтобы не попасть на границу суток). */
+export function noon(d: Date): Date {
+  return new Date(d.getFullYear(), d.getMonth(), d.getDate(), 12, 0, 0);
+}
+
+export function addDays(d: Date, n: number): Date {
+  return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n, 12, 0, 0);
+}
+
+export function daysInMonth(year: number, month0: number): number {
+  return new Date(year, month0 + 1, 0).getDate();
+}
+
+const pad = (n: number) => String(n).padStart(2, '0');
+
+/** «2026-10-03» (локальная дата). */
+export function isoDate(d: Date): string {
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+/** «03.10.2026». */
+export function dotDate(d: Date): string {
+  return `${pad(d.getDate())}.${pad(d.getMonth() + 1)}.${d.getFullYear()}`;
+}
+
+/** Григорианский месяц на иврите: «אוקטובר». */
+export function gregMonthName(year: number, month0: number): string {
+  return new Intl.DateTimeFormat('he', { month: 'long' }).format(new Date(year, month0, 1, 12));
+}
+
+export type HebrewParts = { day: number; month: string; year: number };
+
+export function hebrewParts(d: Date): HebrewParts {
+  const parts = new Intl.DateTimeFormat('he-u-ca-hebrew-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' }).formatToParts(
+    noon(d),
+  );
+  const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
+  const month = get('month');
+  return { day: Number(get('day')), month: MONTH_FIX[month] ?? month, year: Number(get('year')) };
+}
+
+/** Год без тысяч: 5787 → «תשפ״ז». */
+export function hebrewYear(year: number): string {
+  return gematria(year % 1000);
+}
+
+/** «כ״ב תשרי תשפ״ז». */
+export function hebrewDate(d: Date): string {
+  const p = hebrewParts(d);
+  return `${gematria(p.day)} ${p.month} ${hebrewYear(p.year)}`;
+}
+
+/** «כ׳ תשרי». */
+export function hebrewDayMonth(d: Date): string {
+  const p = hebrewParts(d);
+  return `${gematria(p.day)} ${p.month}`;
+}
+
+/** Двойной заголовок календаря: «תשרי – חשון תשפ״ז» / «אלול תשפ״ו – תשרי תשפ״ז». */
+export function hebrewMonthRange(year: number, month0: number): string {
+  const a = hebrewParts(new Date(year, month0, 1, 12));
+  const b = hebrewParts(new Date(year, month0, daysInMonth(year, month0), 12));
+  if (a.year !== b.year) return `${a.month} ${hebrewYear(a.year)} – ${b.month} ${hebrewYear(b.year)}`;
+  if (a.month === b.month) return `${a.month} ${hebrewYear(a.year)}`;
+  return `${a.month} – ${b.month} ${hebrewYear(a.year)}`;
+}
+
+/** Первый день начиная с `from` (включительно), у которого еврейская дата = `day` и месяц удовлетворяет `month`. */
+export function nextHebrewDay(from: Date, day: number, month: (m: string) => boolean, maxDays = 800): Date | null {
+  for (let i = 0; i <= maxDays; i++) {
+    const d = addDays(from, i);
+    const p = hebrewParts(d);
+    if (p.day === day && month(p.month)) return d;
+  }
+  return null;
+}
