+// Generated by qa-tester © 2026 Nikita Morozov (ניקיטה מורוזוב / Никита Морозов). All rights reserved. ID: QAT-NM-2026-344086DC45B0
+// Подмена часов браузера без потери сессии Supabase (см. .qa/context.md, «Технические заметки»).
+// Проблема: если сразу сдвинуть часы назад, access-token из storageState «выглядит живым» по фальшивому времени,
+// приложение его не обновляет, а сервер (реальное время) отвечает 401.
+// Порядок: 1) открыть приложение на реальном времени и дождаться живого токена (при необходимости — принудительный
+// refresh: POST /auth/v1/token); 2) зафиксировать часы; 3) в localStorage сдвинуть expires_at на fake + 1 ч.
+// Контекст браузера у каждого теста свой — файл .qa/auth/*.json не меняется.
+import { expect, Page } from '@playwright/test';
+
+const AUTH_KEY_SOURCE = '^sb-.+-auth-token$';
+
+async function readExpiresAt(page: Page): Promise<number | null> {
+  return page.evaluate((src) => {
+    const re = new RegExp(src);
+    const key = Object.keys(localStorage).find((k) => re.test(k));
+    if (!key) return null;
+    try {
+      const v = JSON.parse(localStorage.getItem(key) ?? 'null');
+      return typeof v?.expires_at === 'number' ? v.expires_at : null;
+    } catch {
+      return null;
+    }
+  }, AUTH_KEY_SOURCE);
+}
+
+async function setExpiresAt(page: Page, expiresAtSec: number): Promise<void> {
+  await page.evaluate(
+    ({ src, exp }) => {
+      const re = new RegExp(src);
+      const key = Object.keys(localStorage).find((k) => re.test(k));
+      if (!key) throw new Error('Нет сессии Supabase в localStorage');
+      const v = JSON.parse(localStorage.getItem(key) ?? 'null');
+      v.expires_at = exp;
+      localStorage.setItem(key, JSON.stringify(v));
+    },
+    { src: AUTH_KEY_SOURCE, exp: expiresAtSec },
+  );
+}
+
+/**
+ * Открывает `warmupPath` на РЕАЛЬНОМ времени и гарантирует, что access-token в localStorage живой
+ * ещё минимум `minValidMs` (если нет — помечает его истёкшим и перезагружает: приложение делает refresh).
+ */
+export async function ensureFreshSession(page: Page, warmupPath = '/home', minValidMs = 10 * 60_000): Promise<void> {
+  await page.goto(warmupPath);
+  // Приложение само обновляет протухший токен при открытии — ждём живой токен по реальному времени.
+  await expect
+    .poll(async () => ((await readExpiresAt(page)) ?? 0) * 1000 > Date.now(), {
+      message: 'Сессия Supabase не обновилась (истёк refresh-token? нужен npm run qa-login)',
+      timeout: 30_000,
+    })
+    .toBe(true);
+  const exp = (await readExpiresAt(page))!;
+  if (exp * 1000 - Date.now() >= minValidMs) return;
+
+  // Токен скоро истечёт — принудительный refresh на реальном времени.
+  const refreshed = page.waitForResponse(
+    (r) => r.url().includes('/auth/v1/token') && r.request().method() === 'POST',
+    { timeout: 30_000 },
+  );
+  await setExpiresAt(page, Math.floor(Date.now() / 1000) - 60);
+  await page.reload();
+  const resp = await refreshed;
+  expect(resp.ok(), 'refresh-token Supabase отклонён — нужен npm run qa-login').toBe(true);
+  await expect
+    .poll(async () => ((await readExpiresAt(page)) ?? 0) * 1000 - Date.now(), { timeout: 15_000 })
+    .toBeGreaterThan(minValidMs);
+}
+
+/**
+ * Фиксирует часы браузера на `fake`, не ломая сессию: сначала свежий токен на реальном времени,
+ * затем setFixedTime и expires_at = fake + 1 ч. После вызова — page.goto на нужный экран.
+ */
+export async function setFixedTimeKeepingSession(page: Page, fake: Date, warmupPath = '/home'): Promise<void> {
+  await ensureFreshSession(page, warmupPath);
+  await page.clock.setFixedTime(fake);
+  await setExpiresAt(page, Math.floor(fake.getTime() / 1000) + 3600);
+}
