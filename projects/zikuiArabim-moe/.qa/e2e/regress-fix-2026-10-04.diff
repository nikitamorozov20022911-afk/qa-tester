+// Generated by qa-tester © 2026 Nikita Morozov (ניקיטה מורוזוב / Никита Морозов). All rights reserved. ID: QAT-NM-2026-344086DC45B0
+// Независимость автотестов от окна уровня «עלית דרגה — המשך כך» (MilestoneWindow, #milestone-window) на /journey.
+//
+// Как работает приложение (бандл, zustand-store `useJourneyStore`, persist name 'journey'):
+//   localStorage['journey'] = {"state":{"lastAnnouncedRung":{"<profileId>":N},"pendingAchievements":{}},"version":0}
+//   окно уровня показывается, если levelProgress.position > lastAnnouncedRung[profileId].
+//   ВАЖНО: ключ — id профиля (profiles.id из useHomeProfile), а НЕ auth user.id из sb-…-auth-token
+//   (у user1: профиль c750744f-…, auth 8e37439d-…). Поэтому ставим большое значение для всех известных id:
+//   уже лежащих в store, известных профилей и auth user.id (на случай совпадения).
+//
+// Кнопки окна: #milestone-window-close (aria-label «סגירה») — просто закрывает;
+//   #milestone-window-dismiss («חזרה למסך ראשי») — закрывает И уводит на /home, поэтому для страховки не используется.
+import { expect, Page } from '@playwright/test';
+
+/** Известные id профилей тестовых аккаунтов (ключи lastAnnouncedRung). */
+const KNOWN_PROFILE_IDS = ['c750744f-6d79-4dd5-a891-0b3446eb08cd'];
+const SUPPRESS_RUNG = 99;
+
+/**
+ * До навигации: в localStorage['journey'] выставить lastAnnouncedRung = 99 для всех известных id,
+ * не затирая прочие поля store (pendingAchievements, version и т. д.).
+ * Init script срабатывает перед каждой загрузкой документа (goto/reload).
+ * По умолчанию дополнительно ставит автозакрытие окна (page.addLocatorHandler) — страховка, если id профиля неизвестен.
+ * autoDismiss: false — для тестов, которые сами открывают окно достижения (тот же компонент).
+ */
+export async function suppressMilestoneWindow(
+  page: Page,
+  opts: { autoDismiss?: boolean; extraIds?: string[] } = {},
+): Promise<void> {
+  const ids = [...KNOWN_PROFILE_IDS, ...(opts.extraIds ?? [])];
+  await page.addInitScript(
+    ({ ids, rung }) => {
+      try {
+        const all = new Set<string>(ids);
+        const authRe = /^sb-.+-auth-token$/;
+        for (const k of Object.keys(localStorage)) {
+          if (!authRe.test(k)) continue;
+          try {
+            const id = JSON.parse(localStorage.getItem(k) ?? 'null')?.user?.id;
+            if (typeof id === 'string' && id) all.add(id);
+          } catch {
+            /* повреждённый токен — пропускаем */
+          }
+        }
+        let root: any = null;
+        try {
+          root = JSON.parse(localStorage.getItem('journey') ?? 'null');
+        } catch {
+          root = null;
+        }
+        if (!root || typeof root !== 'object') root = { state: {}, version: 0 };
+        const state = root.state && typeof root.state === 'object' ? root.state : {};
+        const rungs: Record<string, number> = { ...(state.lastAnnouncedRung ?? {}) };
+        for (const id of Object.keys(rungs)) all.add(id);
+        for (const id of all) rungs[id] = Math.max(Number(rungs[id]) || 0, rung);
+        root.state = { pendingAchievements: {}, ...state, lastAnnouncedRung: rungs };
+        if (root.version === undefined) root.version = 0;
+        localStorage.setItem('journey', JSON.stringify(root));
+      } catch {
+        /* about:blank / нет доступа к localStorage — пропускаем */
+      }
+    },
+    { ids, rung: SUPPRESS_RUNG },
+  );
+  if (opts.autoDismiss !== false) {
+    // noWaitAfter: если за окном уровня в очереди следующее — обработчик сработает снова перед следующим действием.
+    await page.addLocatorHandler(
+      page.locator('#milestone-window'),
+      async (win) => {
+        await win.getByRole('button', { name: 'סגירה' }).click();
+      },
+      { noWaitAfter: true },
+    );
+  }
+}
+
+/**
+ * Страховка: если окно уровня (#milestone-window) появилось в течение timeout — закрыть «סגירה»
+ * и дождаться скрытия (повторяет, если следом показано следующее окно очереди).
+ */
+export async function dismissMilestoneIfShown(page: Page, timeout = 1_500): Promise<void> {
+  const win = page.locator('#milestone-window');
+  for (let i = 0; i < 5; i++) {
+    const shown = await win
+      .first()
+      .waitFor({ state: 'visible', timeout: i === 0 ? timeout : 1_000 })
+      .then(
+        () => true,
+        () => false,
+      );
+    if (!shown) return;
+    await win.getByRole('button', { name: 'סגירה' }).click();
+    await expect(win).toBeHidden({ timeout: 10_000 });
+  }
+}
