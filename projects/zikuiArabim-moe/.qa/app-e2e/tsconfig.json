{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "mocha",
      "@wdio/globals/types",
      "@wdio/mocha-framework"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "wdio.conf.ts",
    "helpers/**/*.ts",
    "specs/**/*.ts"
  ]
}